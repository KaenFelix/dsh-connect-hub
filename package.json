{
  "name": "dsh-connect-hub",
  "version": "1.0.1",
  "description": "One sidebar page for every DeepSeek Harness connector: see which platforms are installed and switched on, install or toggle them, and read their credit balances and expiry dates side by side.",
  "license": "MIT",
  "author": "Felix <kaenfelix@gmail.com>",
  "homepage": "https://github.com/KaenFelix/dsh-connect-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaenFelix/dsh-connect-hub.git"
  },
  "bugs": {
    "url": "https://github.com/KaenFelix/dsh-connect-hub/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "connector",
    "credits",
    "balance"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./assets/*": "./lib/assets/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/CONNECTORS.md",
    "lib/assets",
    "docs/screenshot-panel.jpg",
    "docs/screenshot-connector-states.jpg",
    "docs/screenshot-composer.jpg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
